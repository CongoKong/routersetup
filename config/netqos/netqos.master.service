[Unit]
Description=Network Quality of Service (CAKE)

# --- firewall must be initialized before we attach qdiscs ---
# nftables may create/modify interfaces or apply rules that affect packet paths
After=nftables.service

# --- ensure the NIC exists as a kernel device before running the script ---
# this is the most deterministic way to wait for the actual hardware
# it prevents races with udev renaming or delayed PCIe initialization
BindsTo=sys-subsystem-net-devices-IFWAN.device
After=sys-subsystem-net-devices-IFWAN.device

[Service]
Type=oneshot

# --- apply CAKE using idempotent script ---
# the script handles operstate, carrier, overhead, and qdisc replacement
ExecStart=/usr/local/sbin/netqos.sh

# --- keep the service "active" after running ---
# prevents systemd from thinking the service failed or needs restarting
RemainAfterExit=yes

# --- security hardening ---
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

PrivateDevices=yes
MemoryDenyWriteExecute=yes
RestrictNamespaces=yes

[Install]
# --- start at boot, after multi-user.target is reached ---
WantedBy=multi-user.target
